#!/bin/bash
# NCI Gadi job array for the `standalone/` scripts (CleanRL-style, no frankenrl config
# system) - one sub-job per line of standalone_suite.txt (a script path + optional CLI
# overrides). Parallel to train_suite.pbs, which drives the framework's YAML-config agents
# instead; use this one for TD7/SimBa-SAC/SimBa-TD3, which have no framework port yet.
#
# Submit:  GYM_ENV=Ant-v5 SEED=0 qsub -v GYM_ENV,SEED,TOTAL_STEPS,SUITE -J 0-6 scripts/gadi/train_standalone_suite.pbs
#   (the -J range must match SUITE's non-comment line count - 1: 0-6 for the default 7-script
#    standalone_suite.txt, 0-5 for the 6-script compare_suite.txt (SEED=0 GYM_ENV=Ant-v5
#    SUITE=scripts/gadi/compare_suite.txt qsub -v GYM_ENV,SEED,TOTAL_STEPS,SUITE -J 0-5 ...);
#    scripts/gadi/submit_standalone.sh wraps this and computes the range for you, for either
#    suite, across multiple seeds)
#   THE -v FLAG IS NOT OPTIONAL: `VAR=value qsub ...` only sets VAR for the qsub client
#   process, not the submitted job - PBS Pro needs `-v VAR` (bare name) to forward that
#   value through. Without it every job silently uses this script's defaults below,
#   regardless of what you set on the command line.
#   NOT CALLED "ENV": $ENV is POSIX-sh-reserved (a shell reads it at startup to source an
#   rc-equivalent file) - Gadi's own environment sets it to the Modules system's init
#   script, which silently clobbers a plain `ENV=` variable of your own. Learned this the
#   hard way on the first submission (see git history) - every job failed instantly with
#   env=/opt/Modules/v4.3.0/init/profile.sh instead of the intended Gym env id.
#
# One-time setup, ON THE LOGIN NODE (compute nodes have no outbound internet, so this
# can't happen inside the PBS job itself):
#   cd /g/data/$PROJECT/$USER/frankenrl        # wherever you cloned this repo
#   curl -LsSf https://astral.sh/uv/install.sh | sh   # skip if uv is already installed
#   module load python3/3.11.7
#   uv sync --extra mujoco                     # builds .venv/ here, reused by every job
#   which uv                                   # confirm it resolves BEFORE relying on PATH below
# This job then runs everything via `uv run`, which activates that .venv automatically -
# no manual `source .venv/bin/activate` needed inside the PBS script itself. PBS batch jobs
# run a non-login shell that does NOT source the profile files an interactive SSH session
# does, so ~/.local/bin (where the installer puts uv) is not on PATH by default - the
# explicit export below is required, not defensive boilerplate (first submission failed
# with "uv: command not found" without it).
#
#PBS -N frankenrl_standalone_suite
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=24:00:00
#PBS -l wd
#PBS -P qy44
#PBS -l storage=gdata/qy44+scratch/qy44
#PBS -j oe
#PBS -r y

set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"   # uv lives here; PBS batch shells don't source ~/.bashrc

module load python3/3.11.7

SUITE="${SUITE:-scripts/gadi/standalone_suite.txt}"
GYM_ENV="${GYM_ENV:-Ant-v5}"
TOTAL_STEPS="${TOTAL_STEPS:-1000000}"
SEED="${SEED:-0}"
OUT_ROOT="/scratch/${PBS_O_PROJECT:-qy44}/${USER}/frankenrl-standalone"
mkdir -p "$OUT_ROOT"

# pick this sub-job's line (blank/`#` lines ignored)
LINE=$(grep -vE '^\s*(#|$)' "$SUITE" | sed -n "$((PBS_ARRAY_INDEX + 1))p")
if [ -z "$LINE" ]; then
    echo "no suite line for index ${PBS_ARRAY_INDEX} in ${SUITE}" >&2
    exit 1
fi

SCRIPT=$(echo "$LINE" | awk '{print $1}')
EXTRA=$(echo "$LINE" | cut -s -d' ' -f2-)          # optional extra CLI flags
LABEL=$(basename "${SCRIPT%.py}")_${GYM_ENV}_s${SEED}
LOG="${OUT_ROOT}/${LABEL}.log"

echo "[$(date)] index=${PBS_ARRAY_INDEX} script=${SCRIPT} env=${GYM_ENV} label=${LABEL} extra='${EXTRA}'"

# standalone/ scripts take everything as CLI flags - no PYTHONPATH/editable-install needed,
# no frankenrl import at all (that's the point - see standalone/README.md). `uv run` picks
# up the .venv/ built during the one-time setup above; no manual activation needed.
# --no-sync is REQUIRED here, not an optimisation: without it, `uv run` re-verifies the
# whole project on every invocation, including rebuilding the frankenrl package itself in
# editable mode - which needs to fetch hatchling from PyPI, and compute nodes have no
# outbound internet. --no-sync uses the .venv exactly as `uv sync` left it on the login node.
# PYTHONUNBUFFERED=1 is REQUIRED too, not defensive: Python block-buffers stdout when it's
# piped rather than attached to a terminal, and a PBS walltime kill is an abrupt SIGKILL that
# never lets the process flush that buffer on exit. Without this, a run that hits the
# walltime limit loses everything since its last automatic buffer flush - confirmed the hard
# way when BRO ran the full 8h on real GPU work and its .log came out at 0 bytes.
PYTHONUNBUFFERED=1 uv run --no-sync python3 "$SCRIPT" \
    --env "$GYM_ENV" \
    --seed "$SEED" \
    --total-steps "$TOTAL_STEPS" \
    ${EXTRA} \
    2>&1 | tee "$LOG"

echo "[$(date)] done ${LABEL} -> ${LOG}"
