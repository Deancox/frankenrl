#!/bin/bash
# NCI Gadi job array for the `standalone/` scripts (CleanRL-style, no frankenrl config
# system) - one sub-job per line of standalone_suite.txt (a script path + optional CLI
# overrides). Parallel to train_suite.pbs, which drives the framework's YAML-config agents
# instead; use this one for TD7/SimBa-SAC/SimBa-TD3, which have no framework port yet.
#
# Submit:  ENV=Ant-v5 SEED=0 qsub -v ENV,SEED,TOTAL_STEPS,SUITE -J 0-5 scripts/gadi/train_standalone_suite.pbs
#   (range must match standalone_suite.txt's non-comment line count - 1;
#    scripts/gadi/submit_standalone.sh wraps this for multiple seeds)
#   THE -v FLAG IS NOT OPTIONAL: `VAR=value qsub ...` only sets VAR for the qsub client
#   process, not the submitted job - PBS Pro needs `-v VAR` (bare name) to forward that
#   value through. Without it every job silently uses this script's defaults below,
#   regardless of what you set on the command line.
#
# One-time setup, ON THE LOGIN NODE (compute nodes have no outbound internet, so this
# can't happen inside the PBS job itself):
#   cd /g/data/$PROJECT/$USER/frankenrl        # wherever you cloned this repo
#   curl -LsSf https://astral.sh/uv/install.sh | sh   # skip if uv is already installed
#   module load python3/3.11.7
#   uv sync --extra mujoco                     # builds .venv/ here, reused by every job
# This job then runs everything via `uv run`, which activates that .venv automatically -
# no manual `source .venv/bin/activate` needed inside the PBS script itself.
#
#PBS -N frankenrl_standalone_suite
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=8:00:00
#PBS -l wd
#PBS -P qy44
#PBS -l storage=gdata/qy44+scratch/qy44
#PBS -j oe
#PBS -r y

set -euo pipefail

module load python3/3.11.7

SUITE="${SUITE:-scripts/gadi/standalone_suite.txt}"
ENV="${ENV:-Ant-v5}"
TOTAL_STEPS="${TOTAL_STEPS:-1000000}"
SEED="${SEED:-0}"
OUT_ROOT="/scratch/${PBS_O_PROJECT:-qy44}/${USER}/frankenrl-standalone"
mkdir -p "$OUT_ROOT"

# pick this sub-job's line (blank/`#` lines ignored)
LINE=$(grep -vE '^\s*(#|$)' "$SUITE" | sed -n "$((PBS_ARRAY_INDEX + 1))p")
if [ -z "$LINE" ]; then
    echo "no suite line for index ${PBS_ARRAY_INDEX} in ${SUITE}" >&2
    exit 1
fi

SCRIPT=$(echo "$LINE" | awk '{print $1}')
EXTRA=$(echo "$LINE" | cut -s -d' ' -f2-)          # optional extra CLI flags
LABEL=$(basename "${SCRIPT%.py}")_${ENV}_s${SEED}
LOG="${OUT_ROOT}/${LABEL}.log"

echo "[$(date)] index=${PBS_ARRAY_INDEX} script=${SCRIPT} env=${ENV} label=${LABEL} extra='${EXTRA}'"

# standalone/ scripts take everything as CLI flags - no PYTHONPATH/editable-install needed,
# no frankenrl import at all (that's the point - see standalone/README.md). `uv run` picks
# up the .venv/ built during the one-time setup above; no manual activation needed.
uv run python3 "$SCRIPT" \
    --env "$ENV" \
    --seed "$SEED" \
    --total-steps "$TOTAL_STEPS" \
    ${EXTRA} \
    2>&1 | tee "$LOG"

echo "[$(date)] done ${LABEL} -> ${LOG}"
