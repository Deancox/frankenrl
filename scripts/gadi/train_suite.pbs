#!/bin/bash
# NCI Gadi job array: one sub-job per line of suite.txt (a config path + optional overrides).
# Submit:  qsub -J 0-5 scripts/gadi/train_suite.pbs      (range must match suite.txt length-1)
#
#PBS -N frankenrl_suite
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=48GB
#PBS -l walltime=8:00:00
#PBS -l wd
#PBS -P qy44
#PBS -l storage=gdata/qy44+scratch/qy44
#PBS -j oe
#PBS -r y

set -euo pipefail

module load python3/3.11.7
module load pytorch/2.12.0

SUITE="${SUITE:-scripts/gadi/suite.txt}"
SEED="${SEED:-0}"
OUT_ROOT="/scratch/${PBS_O_PROJECT:-qy44}/${USER}/frankenrl"

# pick this sub-job's line (blank/`#` lines ignored)
LINE=$(grep -vE '^\s*(#|$)' "$SUITE" | sed -n "$((PBS_ARRAY_INDEX + 1))p")
if [ -z "$LINE" ]; then
    echo "no suite line for index ${PBS_ARRAY_INDEX} in ${SUITE}" >&2
    exit 1
fi

CONFIG=$(echo "$LINE" | awk '{print $1}')
EXTRA=$(echo "$LINE" | cut -s -d' ' -f2-)          # optional `-o key=value` overrides
LABEL=$(basename "${CONFIG%.yaml}")_s${SEED}

echo "[$(date)] index=${PBS_ARRAY_INDEX} config=${CONFIG} label=${LABEL} extra='${EXTRA}'"

# editable-installed once on /scratch, or rely on PYTHONPATH=src
export PYTHONPATH="${PWD}/src:${PYTHONPATH:-}"
python3 -m frankenrl.run \
    --config "$CONFIG" \
    --seed "$SEED" \
    --label "$LABEL" \
    --out-dir "$OUT_ROOT" \
    ${EXTRA}

echo "[$(date)] done ${LABEL}"
